---

import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const termsPost = await getEntry("spec", "terms");

if (!termsPost) {
	throw new Error("Terms page content not found");
}

const { Content } = await render(termsPost);
---
<MainGridLayout title={i18n(I18nKey.terms)} description={i18n(I18nKey.terms)}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>